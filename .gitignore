# Ambiente Virtuale
.venv/
venv/
env/
__pycache__/
*.pyc

# Dati Locali del RAG (Generati dagli script)
rag/database/qdrant_data/
# Versionamento blue/green degli artefatti: directory versionate + puntatore CURRENT
rag/database/versions/
rag/database/CURRENT
# Artefatti indice, formati flat legacy (JSON + vettori .npz + sidecar)
rag/database/graph.json
rag/database/colbert.npz
rag/database/chunks.json
rag/database/dense.npz
rag/database/code.npz
rag/database/code.json
# Artefatti indice, formati legacy (pickle) — letti solo per retrocompatibilità
rag/database/graph.pkl
rag/database/colbert.pkl
rag/database/chunks.pkl
# Journal dei job di reindex (append-only, ricostruito al boot)
rag/database/reindex_jobs.jsonl
# Journal di intake staging (append-only, generato a runtime)
rag/database/staging/intake.jsonl
# Alert dei batch notturni (append-only, letti da /api/health)
rag/database/alerts.jsonl
# File del writer lock cross-processo (il mutex è il lock OS, il file resta su disco)
rag/database/.writer.lock

# Configurazione (Opzionale: escludilo se contiene chiavi API private OpenAI/Anthropic)
# rag_config.yaml

# File di sistema
.DS_Store
Thumbs.db

# IDE
.idea/
rag/database/dense.pkl
rag/database/code.pkl

# Backup manuali degli snapshot Qdrant (es. rete di sicurezza pre-flip S9): binari,
# non fanno parte del codice, non vanno nella history del repo.
qdrant_snapshots_backup/

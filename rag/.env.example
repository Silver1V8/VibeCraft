# .env.example — copia questo file in rag/.env.local e adatta i valori.
#
# rag/.env.local e' gitignorato (mai committato) ed e' caricato da core/config.py PRIMA
# che qualunque modulo legga os.environ, quindi vale comunque tu avvii il server:
# `uv run python server.py`, uno script, o una run configuration dell'IDE.
# Una variabile gia' impostata nell'ambiente vince sempre su questo file (override=False).
#
# TUTTE le variabili qui sotto sono OPZIONALI: senza questo file il sistema parte con i
# default indicati, che sono pensati per un'installazione locale su loopback.


# ─────────────────────────────────────────────────────────────────────────────
# Rete e accesso
# ─────────────────────────────────────────────────────────────────────────────

# Interfaccia su cui il server ascolta. Default: 127.0.0.1 (solo questa macchina).
# ATTENZIONE: qualunque valore diverso dal loopback — 0.0.0.0 compreso — rende il server
# raggiungibile dalla rete. In quel caso VIBECRAFT_API_KEY smette di essere facoltativa
# (vedi sotto) e le funzioni che hanno senso solo in locale (selettore di cartelle nativo,
# scansione di un path arbitrario) vengono DISATTIVATE, non solo protette.
#VIBECRAFT_HOST=127.0.0.1

# Porta HTTP. Default: 8000.
#VIBECRAFT_PORT=8000

# Chiave per l'header X-API-Key su /api/* e /ask.
# Se NON impostata non c'e' autenticazione. Va bene finche' il bind resta su loopback;
# diventa un problema serio nel momento in cui cambi VIBECRAFT_HOST.
# Le richieste che arrivano da 127.0.0.1 bypassano il controllo anche con la chiave attiva
# (gli endpoint mutanti usano una variante senza bypass).
# Generane una a caso, non sceglierla a mano:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#VIBECRAFT_API_KEY=

# URL con cui questo server e' raggiungibile DA FUORI dal processo (un agente CLI, uno
# script). Serve solo a scriverlo dentro prompt e artefatti, mai a bindare. Default:
# derivato da VIBECRAFT_HOST/VIBECRAFT_PORT (127.0.0.1 se il bind è 0.0.0.0 o ::). Impostalo quando il server sta dietro un
# reverse proxy o su un altro host.
#VIBECRAFT_BASE_URL=

# Nomi extra ammessi nell'header Host, separati da virgole (difesa dal DNS rebinding).
# Sempre ammessi: 127.0.0.1, localhost, ::1, l'indirizzo di VIBECRAFT_HOST se specifico e
# l'host di VIBECRAFT_BASE_URL; ogni altro Host riceve 400. Serve se raggiungi il server
# con un nome di LAN o dietro un reverse proxy che inoltra il proprio Host. Niente wildcard:
# le voci con "*" sono ignorate con un avviso all'avvio.
#VIBECRAFT_ALLOWED_HOSTS=vibecraft.lan,192.168.1.20

# Token per l'header X-Gitlab-Token su POST /api/reindex (trigger di reindicizzazione da
# CI/webhook). Se non impostato, quell'endpoint non e' utilizzabile da remoto.
#VIBECRAFT_GITLAB_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Servizi esterni
# ─────────────────────────────────────────────────────────────────────────────

# Qdrant in server mode. Default: http://127.0.0.1:6333 (il docker-compose di questo repo).
#QDRANT_URL=http://127.0.0.1:6333

# Chiave API di Qdrant. Lasciala COMMENTATA se Qdrant gira senza autenticazione:
# Qdrant tratta una stringa VUOTA come "chiave attiva ma vuota" e rifiuta ogni richiesta.
# Va valorizzata solo se hai davvero abilitato QDRANT__SERVICE__API_KEY lato server.
#QDRANT_API_KEY=

# Endpoint Ollama. Default: http://127.0.0.1:11434.
# In Docker su macOS conviene tenere Ollama NATIVO sull'host (usa Metal; in container
# girerebbe su CPU) e puntare qui: http://host.docker.internal:11434
#VIBECRAFT_OLLAMA_URL=http://127.0.0.1:11434

# Timeout delle chiamate a Ollama, in secondi. Default: 1800 (30 minuti).
# Alto di proposito: le generazioni della pipeline su modelli locali sono lente.
#VIBECRAFT_OLLAMA_TIMEOUT_SECONDS=1800

# Chiave API Anthropic. Serve SOLO se in rag_config.yaml scegli il provider "anthropic"
# per qualche step (llm_settings.active_provider o llm_settings.purposes).
# Con provider "ollama" (il default) e' completamente inutilizzata.
#ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Prestazioni e ritenzione (tutte con default sensati: toccale solo se misuri un problema)
# ─────────────────────────────────────────────────────────────────────────────

# Quante embedding concorrenti il server puo' avere in volo. Default: 2.
#VIBECRAFT_EMBED_CONCURRENCY=2

# Voci massime nella cache in-process delle risposte di /ask. Default: 256. 0 = disattivata.
# La chiave include index_version: dopo un reindex o un rollback le voci vecchie smettono
# semplicemente di essere consultate.
#VIBECRAFT_ASK_CACHE_SIZE=256

# Quante versioni dell'indice (blue/green) conservare in database/versions/. Default: 5.
# Le piu' vecchie vengono rimosse a ogni promozione; una versione in meno e' un rollback
# in meno disponibile.
#VIBECRAFT_INDEX_KEEP=5

# Dimensione delle fette di upsert verso Qdrant. Default: 256. Un upsert monolitico su
# migliaia di punti rischia il timeout lato client.
#VIBECRAFT_QDRANT_UPSERT_BATCH=256

# Livello di log. Default: INFO. Valori: DEBUG, INFO, WARNING, ERROR.
#VIBECRAFT_LOG_LEVEL=INFO


# ─────────────────────────────────────────────────────────────────────────────
# Batch notturni (scripts/nightly_consistency.*, scripts/weekly_consistency.*)
# ─────────────────────────────────────────────────────────────────────────────

# URL a cui gli script di consistenza interrogano il server. Default: http://127.0.0.1:8000
#VIBECRAFT_SERVER_URL=http://127.0.0.1:8000

# Webhook (POST JSON) a cui notificare i fallimenti dei batch notturni. Se non impostato
# l'alert viene comunque scritto in database/alerts.jsonl e letto da GET /api/health.
#VIBECRAFT_ALERT_WEBHOOK=

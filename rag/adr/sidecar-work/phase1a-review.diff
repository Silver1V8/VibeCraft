 def _wait(cond, timeout=5.0):
     """Attende attivamente che `cond()` sia vero, entro timeout."""
     deadline = time.time() + timeout
     while time.time() < deadline:
         if cond():
             return True
         time.sleep(0.02)
     return cond()
 
 
